# ============================================================
# NOVA frontend environment template
# Copy to frontend/.env and edit. The real .env is gitignored.
# Vite only exposes variables prefixed with VITE_ to client code.
# ============================================================

# Base URL for the backend API.
# Leave empty in development to use the Vite proxy (/api -> localhost:8000).
# Example for production: https://api.example.com
VITE_API_BASE_URL=
