# ============================================================
# NOVA backend environment template
# Copy to backend/.env and edit. The real .env is gitignored.
# All variables use the NOVA_ prefix (see app/config.py).
# ============================================================

# runtime environment: development | production | test
NOVA_ENV=development

# FastAPI app name shown in /docs and logs
NOVA_APP_NAME=NOVA

# debug mode (verbose error pages); keep false in production
NOVA_DEBUG=true

# uvicorn bind address (override only if needed)
NOVA_HOST=0.0.0.0
NOVA_PORT=8000

# comma-separated list of allowed browser origins for CORS
NOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# log level: DEBUG | INFO | WARNING | ERROR
NOVA_LOG_LEVEL=INFO

# intent classifier backend: auto | sklearn | embedding | keyword
# auto = sklearn artifacts first (fast); embedding = sentence-transformers
NOVA_INTENT_BACKEND=auto

# conversation memory store (Phase 6). Empty = process-local in-memory store.
# PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/nova
# SQLite:    sqlite:///./nova.db
NOVA_DATABASE_URL=

# how many recent messages form the session context window (0 disables memory)
NOVA_MEMORY_WINDOW=12
