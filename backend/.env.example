# ============================================================
# NOVA backend environment template
# Copy to backend/.env and edit. The real .env is gitignored.
# All variables use the NOVA_ prefix (see app/config.py).
# ============================================================

# runtime environment: development | production | test
NOVA_ENV=development

# FastAPI app name shown in /docs and logs
NOVA_APP_NAME=NOVA

# debug mode (verbose error pages); keep false in production
NOVA_DEBUG=true

# uvicorn bind address (override only if needed)
NOVA_HOST=0.0.0.0
NOVA_PORT=8000

# comma-separated list of allowed browser origins for CORS
NOVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# log level: DEBUG | INFO | WARNING | ERROR
NOVA_LOG_LEVEL=INFO

# intent classifier backend: auto | sklearn | embedding | keyword
# auto = sklearn artifacts first (fast); embedding = sentence-transformers
NOVA_INTENT_BACKEND=auto

# conversation memory store (Phase 6). Empty = process-local in-memory store.
# PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/nova
# SQLite:    sqlite:///./nova.db
NOVA_DATABASE_URL=

# how many recent messages form the session context window (0 disables memory)
NOVA_MEMORY_WINDOW=12

# --- Phase 7: retrieval-augmented generation ---
# chunks retrieved per document question
NOVA_RAG_TOP_K=4
# cosine gate: best chunk below this score -> honest refusal, no guessing
NOVA_RAG_MIN_SCORE=0.35
# upload size cap for POST /api/documents/upload (1-100 MB)
NOVA_MAX_UPLOAD_MB=10
# where uploaded files are stored; empty = nova/data/documents/
NOVA_DOCUMENT_DIR=

# --- Phase 8: LLM reply generation ---
# auto = OpenAI when OPENAI_API_KEY is set, HuggingFace when HF_TOKEN is set,
# otherwise deterministic template replies (the safe default, no key needed)
# options: auto | openai | huggingface | local | mock | none
NOVA_LLM_PROVIDER=auto
# model override; empty = provider default (gpt-4o-mini / Mistral-7B / distilgpt2)
NOVA_LLM_MODEL=
NOVA_LLM_MAX_TOKENS=256
NOVA_LLM_TEMPERATURE=0.2
NOVA_LLM_TIMEOUT=30

# Secrets are read from the environment only — never put real keys in .env
# files you commit (backend/.env is gitignored):
#   OPENAI_API_KEY=sk-...
#   HF_TOKEN=hf_...
