# --- Secrets / env ---
.env
.env.local
*.env.local

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Models / artifacts (large, retrain instead of committing) ---
# Exception: the small Phase 3 intent artifacts are committed so a fresh
# clone works without retraining.
backend/artifacts/*
!backend/artifacts/intent/
*.joblib
!backend/artifacts/intent/*.joblib
*.pkl
*.pt
*.bin
*.onnx

# --- Data (user uploads stay local) ---
data/documents/*
!data/documents/.gitkeep
# The intent dataset is hand-written source code — it must be committed.
data/intents/*
!data/intents/.gitkeep
!data/intents/intents.json

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.local

# --- Notebooks ---
.ipynb_checkpoints/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/
